{
  "name": "dark-fire",
  "displayName": "Dark Fire",
  "description": "A self-contained Dark Fire theme generator with VS Code, Ghostty, and web outputs",
  "version": "0.3.0",
  "publisher": "cgbur",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/cgbur/dark-fire.git"
  },
  "bugs": {
    "url": "https://github.com/cgbur/dark-fire/issues"
  },
  "homepage": "https://github.com/cgbur/dark-fire#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark-fire",
    "pale-fire",
    "zenburn",
    "dark",
    "full-black",
    "ghostty",
    "css"
  ],
  "scripts": {
    "check": "zig fmt --check build.zig src && zig build test",
    "vscode:prepublish": "zig fmt --check build.zig src && zig build test && zig build run -- generate",
    "package:vscode": "vsce package",
    "publish:vscode": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dark Fire 01 - Original",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-color-theme.json"
      },
      {
        "label": "Dark Fire 02 - Original High Contrast",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-high-contrast-color-theme.json"
      },
      {
        "label": "Dark Fire 03 - Stealth",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-stealth-color-theme.json"
      },
      {
        "label": "Dark Fire 04 - Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-dark-color-theme.json"
      },
      {
        "label": "Dark Fire 05 - Darker",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-darker-color-theme.json"
      },
      {
        "label": "Dark Fire 06 - Deep Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-deep-dark-color-theme.json"
      },
      {
        "label": "Dark Fire 07 - Near Black",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-near-black-color-theme.json"
      },
      {
        "label": "Dark Fire 08 - Full Black",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/dark-fire-full-black-color-theme.json"
      }
    ]
  }
}
